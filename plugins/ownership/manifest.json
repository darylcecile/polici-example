{
  "schema": "polici.plugin/v2",
  "schemaVersion": 2,
  "name": "ownership",
  "version": "1.0.0",
  "policiApi": 1,
  "contractMajor": 1,
  "documentation": {
    "summary": "Example repository ownership policy provider."
  },
  "types": {},
  "exports": {
    "approved": {
      "kind": "function",
      "parameters": [
        {
          "name": "owner",
          "type": {
            "kind": "string",
            "enum": ["frontend", "platform"]
          }
        }
      ],
      "returns": {
        "kind": "boolean"
      },
      "resolve": "approved",
      "summary": "Whether this example repository recognizes the owner."
    }
  },
  "permissions": [],
  "runtime": {
    "kind": "typescript",
    "protocol": 1,
    "entrypoint": "./runtime-linux-x64",
    "transport": "jsonl",
    "capabilities": []
  }
}
